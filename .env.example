# Sao chép file này thành .env rồi điền giá trị.

# ---- LLM (để trống = chỉ truy xuất đoạn văn bản, không sinh câu trả lời) ----
# Chọn một: none | gemini | openai | anthropic
LLM_PROVIDER=LLM_PROVIDER=extractive

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI hoặc bất kỳ dịch vụ tương thích OpenAI (Groq, OpenRouter, Ollama chạy local...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Ví dụ Ollama local: OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_MODEL=qwen2.5:3b  OPENAI_API_KEY=ollama

# ---- Embedding (tùy chọn) ----
# Để trống = chỉ dùng BM25. Ví dụ: BAAI/bge-m3 (cần: pip install sentence-transformers)
EMBEDDING_MODEL=

# Kho vector: sqlite (mặc định) hoặc chroma (cần: pip install chromadb và bật EMBEDDING_MODEL)
VECTOR_STORE=sqlite

# ---- Rerank (tùy chọn) ----
# Để trống = tắt. Ví dụ: BAAI/bge-reranker-v2-m3 (cần sentence-transformers)
RERANK_MODEL=
# Bỏ các đoạn có điểm rerank thấp hơn ngưỡng này (0 = không bỏ)
RERANK_MIN_SCORE=0

# ---- OCR cho PDF scan (tùy chọn) ----
# 1 = bật. Cần: pip install pypdfium2 pytesseract pillow và cài chương trình Tesseract kèm gói tiếng Việt (vie)
OCR=0
OCR_LANG=vie+eng
# Windows: đường dẫn tới tesseract.exe nếu chưa nằm trong PATH
TESSERACT_CMD=

# ---- Truy xuất ----
TOP_K=5
# Tỷ lệ từ khóa trong câu hỏi phải xuất hiện trong đoạn văn để được coi là có căn cứ (0-1)
MIN_COVERAGE=0.4
# Chỉ dùng BM25: bỏ đoạn có điểm thấp hơn REL_SCORE x điểm của đoạn đứng đầu (0-1)
REL_SCORE=0.45
# Chỉ dùng khi bật embedding: ngưỡng cosine tối thiểu
EMBEDDING_MIN_SIM=0.45

# ---- Máy chủ ----
# Mặc định chỉ máy bạn truy cập được. Muốn máy khác trong LAN/Radmin vào: APP_HOST=0.0.0.0 
APP_HOST=127.0.0.1
APP_PORT=8000

# ---- Tài khoản ----
# Quản trị viên đầu tiên, chỉ dùng khi CSDL chưa có quản trị viên nào.
# Để trống ADMIN_PASSWORD: hệ thống tự sinh mật khẩu và in ra cửa sổ Run một lần.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=JgVkelXXE9Jk
# Quên mật khẩu quản trị viên cuối cùng: đặt =1 cùng ADMIN_PASSWORD mới, chạy một lần rồi xóa dòng này.
ADMIN_FORCE_RESET=0
# Số ngày giữ đăng nhập
SESSION_DAYS=7
# Đặt 1 khi chạy qua HTTPS
COOKIE_SECURE=0

# ---- Tải lên ----
MAX_UPLOAD_MB=25
